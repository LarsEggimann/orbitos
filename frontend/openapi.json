{"openapi": "3.1.0", "info": {"title": "ORBITOS API", "version": "0.1.0"}, "paths": {"/orbitos-api/v1/{device_id}/connect/{ip}": {"post": {"tags": ["electrometer"], "summary": "Connect To Electrometer", "description": "Connect to the electrometer with the given device ID.", "operationId": "electrometer-connect_to_electrometer", "parameters": [{"name": "ip", "in": "path", "required": true, "schema": {"type": "string", "title": "Ip"}}, {"name": "device_id", "in": "path", "required": true, "schema": {"$ref": "#/components/schemas/ElectrometerID"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/BaseResponse"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/orbitos-api/v1/{device_id}/state": {"get": {"tags": ["electrometer"], "summary": "Get Electrometer State", "description": "Get the current state of the electrometer.", "operationId": "electrometer-get_electrometer_state", "parameters": [{"name": "device_id", "in": "path", "required": true, "schema": {"$ref": "#/components/schemas/ElectrometerID"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ElectrometerState"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}}, "components": {"schemas": {"BaseResponse": {"properties": {"message": {"type": "string", "title": "Message"}, "error": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Error"}}, "type": "object", "required": ["message"], "title": "BaseResponse"}, "ConnectionStatus": {"type": "string", "enum": ["connected", "disconnected", "health check failed"], "title": "ConnectionStatus"}, "ElectrometerID": {"type": "string", "enum": ["electrometer_1", "electrometer_2"], "title": "ElectrometerID"}, "ElectrometerState": {"properties": {"device_id": {"type": "string", "title": "Device Id"}, "status": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Status"}, "connection_status": {"$ref": "#/components/schemas/ConnectionStatus", "default": "disconnected"}, "error": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Error"}, "trigger_count": {"type": "integer", "title": "Trigger Count", "default": 100}, "trigger_time_interval": {"type": "number", "title": "Trigger Time Interval", "default": 0.1}, "trigger_bypass": {"type": "string", "title": "Trigger Bypass", "default": "OFF"}, "trigger_delay": {"type": "number", "title": "Trigger Delay", "default": 0.0}, "function": {"type": "string", "title": "Function", "default": "CURR"}, "aperture_integration_time": {"type": "number", "title": "Aperture Integration Time", "default": 0.2}, "aperture_auto": {"type": "string", "title": "Aperture Auto", "default": "OFF"}, "current_range": {"type": "number", "title": "Current Range", "default": 1e-07}, "current_range_auto": {"type": "string", "title": "Current Range Auto", "default": "ON"}, "current_range_auto_upper_limit": {"type": "number", "title": "Current Range Auto Upper Limit", "default": 1e-07}, "current_range_auto_lower_limit": {"type": "number", "title": "Current Range Auto Lower Limit", "default": 1e-16}}, "type": "object", "required": ["device_id"], "title": "ElectrometerState"}, "HTTPValidationError": {"properties": {"detail": {"items": {"$ref": "#/components/schemas/ValidationError"}, "type": "array", "title": "Detail"}}, "type": "object", "title": "HTTPValidationError"}, "ValidationError": {"properties": {"loc": {"items": {"anyOf": [{"type": "string"}, {"type": "integer"}]}, "type": "array", "title": "Location"}, "msg": {"type": "string", "title": "Message"}, "type": {"type": "string", "title": "Error Type"}}, "type": "object", "required": ["loc", "msg", "type"], "title": "ValidationError"}}}}
