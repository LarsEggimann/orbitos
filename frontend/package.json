{
  "name": "orbitos-v2-frontend",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && tsc --noEmit",
    "start": "node .output/server/index.mjs",
    "generate-client": "openapi-ts",
    "format": "prettier --write .",
    "win:prod":   "concurrently \"cd ../backend && ..\\.venv\\Scripts\\python.exe -m uvicorn src.main:app --host 0.0.0.0 --port 8000\" \"npm run dev\"",
    "win:dev":    "concurrently \"cd ../backend && ..\\.venv\\Scripts\\python.exe -m uvicorn src.main:app --host 0.0.0 --port 8000 --reload\" \"npm run dev\"",
    "linux:prod": "concurrently \"cd ../backend && source ../.venv/bin/activate && python3 -m fastapi run src/main.py\" \"npm run start\"",
    "linux:dev":  "concurrently \"cd ../backend && source ../.venv/bin/activate && python3 -m fastapi dev src/main.py\" \"npm run dev\""
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@hey-api/client-axios": "^0.9.1",
    "@hey-api/client-fetch": "^0.13.1",
    "@mui/icons-material": "^7.1.2",
    "@mui/material": "^7.1.2",
    "@tailwindcss/postcss": "^4.1.10",
    "@tanstack/react-query": "^5.80.10",
    "@tanstack/react-query-devtools": "^5.80.10",
    "@tanstack/react-router": "^1.121.27",
    "@tanstack/react-router-devtools": "^1.121.27",
    "@tanstack/react-router-with-query": "^1.121.27",
    "@tanstack/react-start": "^1.121.29",
    "@toolpad/core": "^0.16.0",
    "plotly.js": "^3.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "react-plotly.js": "^2.6.0",
    "redaxios": "^0.5.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.74.0",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "^24.0.3",
    "@types/plotly.js-dist-min": "^2.3.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/react-plotly.js": "^2.6.3",
    "autoprefixer": "^10.4.21",
    "npm-check-updates": "^18.0.1",
    "concurrently": "^9.2.0",
    "plotly.js-dist-min": "^3.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "prettier": {
    "singleQuote": true,
    "jsxSingleQuote": true,
    "trailingComma": "all",
    "tabWidth": 2,
    "semi": false,
    "quoteProps": "consistent"
  }
}
