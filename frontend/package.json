{
  "name": "orbitos-v2-frontend",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && tsc --noEmit",
    "preview": "vite preview --port 3000 --host",
    "generate-client": "openapi-ts",
    "format": "prettier --write .",
    "win:preview": "concurrently \"cd ../backend && ..\\.venv\\Scripts\\python.exe -m uvicorn src.main:app --host 0.0.0.0 --port 8000\" \"npm run preview\"",
    "win:dev": "concurrently \"cd ../backend && ..\\.venv\\Scripts\\python.exe -m uvicorn src.main:app --host 0.0.0 --port 8000 --reload\" \"npm run dev\"",
    "linux:preview": "concurrently \"cd ../backend && source ../.venv/bin/activate && python3 -m fastapi run src/main.py\" \"npm run preview\"",
    "linux:dev": "concurrently \"cd ../backend && source ../.venv/bin/activate && python3 -m fastapi dev src/main.py\" \"npm run dev\""
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.1",
    "@mui/material": "^9.0.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-query-devtools": "^5.101.0",
    "@tanstack/react-router": "^1.170.11",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/react-router-with-query": "^1.130.17",
    "@tanstack/router-plugin": "^1.168.14",
    "@vitejs/plugin-react": "^6.0.2",
    "axios": "^1.17.0",
    "notistack": "^3.0.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.6.0",
    "react-plotly.js": "^2.6.0",
    "redaxios": "^0.5.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.98.1",
    "@types/material-ui": "^0.21.18",
    "@types/node": "^25.9.1",
    "@types/plotly.js-dist-min": "^2.3.4",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@types/react-plotly.js": "^2.6.4",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.3",
    "npm-check-updates": "^22.2.2",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "prettier": {
    "singleQuote": true,
    "jsxSingleQuote": true,
    "trailingComma": "all",
    "tabWidth": 2,
    "semi": false,
    "quoteProps": "consistent"
  }
}
