                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/orbitos-api/v1/{device_id}/continuous-measurement/stop": {
      "post": {
        "tags": [
          "electrometer"
        ],
        "summary": "Stop Continuous Measurement",
        "description": "Stop continuous measurement on the electrometer.",
        "operationId": "electrometer-stop_continuous_measurement",
        "parameters": [
          {
            "name": "device_id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ElectrometerID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/orbitos-api/v1/{device_id}/trigger-based-measurement/initialize": {
      "post": {
        "tags": [
          "electrometer"
        ],
        "summary": "Initialize Trigger Based Measurement",
        "description": "Initialize trigger-based measurement on the electrometer.",
        "operationId": "electrometer-initialize_trigger_based_measurement",
        "parameters": [
          {
            "name": "device_id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ElectrometerID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/orbitos-api/v1/{device_id}/trigger-based-measurement/start": {
      "post": {
        "tags": [
          "electrometer"
        ],
        "summary": "Start Trigger Based Measurement",
        "description": "Start trigger-based measurement on the electrometer.",
        "operationId": "electrometer-start_trigger_based_measurement",
        "parameters": [
          {
            "name": "device_id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ElectrometerID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
