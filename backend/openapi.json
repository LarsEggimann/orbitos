  },
  "components": {
    "schemas": {
      "BaseResponse": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "BaseResponse"
      },
      "ConnectionStatus": {
        "type": "string",
        "enum": [
          "connected",
          "connecting",
          "disconnected",
          "health check failed"
        ],
        "title": "ConnectionStatus"
      },
      "ElectrometerID": {
        "type": "string",
        "enum": [
          "electrometer_1",
          "electrometer_2"
        ],
        "title": "ElectrometerID"
      },
      "ElectrometerState": {
        "properties": {
          "device_id": {
            "type": "string",
            "title": "Device Id"
          },
          "status": {
            "$ref": "#/components/schemas/ElectrometerStatus",
            "default": "unknown"
          },
          "connection_status": {
            "$ref": "#/components/schemas/ConnectionStatus",
            "default": "disconnected"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "trigger_count": {
            "type": "integer",
            "title": "Trigger Count",
            "default": 100
          },
          "trigger_time_interval": {
            "type": "number",
            "title": "Trigger Time Interval",
            "default": 0.1
          },
          "trigger_bypass": {
            "type": "string",
            "title": "Trigger Bypass",
            "default": "OFF"
          },
          "trigger_delay": {
            "type": "number",
            "title": "Trigger Delay",
            "default": 0.0
          },
          "function": {
            "type": "string",
            "title": "Function",
            "default": "CURR"
          },
          "aperture_integration_time": {
            "type": "number",
            "title": "Aperture Integration Time",
            "default": 0.2
          },
          "aperture_auto": {
            "type": "string",
            "title": "Aperture Auto",
            "default": "OFF"
          },
          "current_range": {
            "type": "number",
            "title": "Current Range",
            "default": 1e-07
          },
          "current_range_auto": {
            "type": "string",
            "title": "Current Range Auto",
            "default": "ON"
          },
          "current_range_auto_upper_limit": {
            "type": "number",
            "title": "Current Range Auto Upper Limit",
            "default": 1e-07
          },
          "current_range_auto_lower_limit": {
            "type": "number",
            "title": "Current Range Auto Lower Limit",
            "default": 1e-16
          }
        },
        "type": "object",
        "required": [
          "device_id"
        ],
        "title": "ElectrometerState"
      },
      "ElectrometerStateSet": {
        "properties": {
          "trigger_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trigger Count"
          },
          "trigger_time_interval": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trigger Time Interval"
          },
          "trigger_bypass": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trigger Bypass"
          },
          "trigger_delay": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trigger Delay"
          },
          "function": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Function"
          },
          "aperture_integration_time": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Aperture Integration Time"
          },
          "aperture_auto": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Aperture Auto"
          },
          "current_range": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Range"
          },
          "current_range_auto": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Range Auto"
          },
          "current_range_auto_upper_limit": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Range Auto Upper Limit"
          },
          "current_range_auto_lower_limit": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Range Auto Lower Limit"
          }
        },
        "type": "object",
        "title": "ElectrometerStateSet"
      },
      "ElectrometerStatus": {
        "type": "string",
        "enum": [
          "unknown",
          "idle",
          "performing_measurement"
        ],
        "title": "ElectrometerStatus"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}