{
  "openapi": "3.1.0",
  "info": {
    "title": "ORBITOS API",
    "version": "0.1.0"
  },
  "paths": {
    "/orbitos-api/v1/{device_id}/connect/{ip}": {
      "post": {
        "tags": [
          "electrometer"
        ],
        "summary": "Connect To Electrometer",
        "description": "Connect to the electrometer with the given device ID.",
        "operationId": "electrometer-connect_to_electrometer",
        "parameters": [
          {
            "name": "ip",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Ip"
            }
          },
          {
            "name": "device_id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ElectrometerID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/orbitos-api/v1/{device_id}/disconnect": {
      "post": {
        "tags": [
          "electrometer"
        ],
        "summary": "Disconnect Electrometer",
        "description": "Disconnect the electrometer.",
        "operationId": "electrometer-disconnect_electrometer",
        "parameters": [
          {
            "name": "device_id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ElectrometerID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/orbitos-api/v1/electrometers/reset": {
      "post": {
        "tags": [
          "electrometer"
        ],
        "summary": "Reset Electrometer",
        "description": "Reset the electrometer.",
        "operationId": "electrometer-reset_electrometer",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                }
              }
            }
          }
        }
      }
    },
    "/orbitos-api/v1/{device_id}/state": {
      "get": {
        "tags": [
          "electrometer"
        ],
        "summary": "Get Electrometer State",
        "description": "Get the current state of the electrometer.",
        "operationId": "electrometer-get_electrometer_state",
        "parameters": [
          {
            "name": "device_id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ElectrometerID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ElectrometerState"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "electrometer"
        ],
        "summary": "Set Electrometer State",
        "description": "Set the state of the electrometer.",
        "operationId": "electrometer-set_electrometer_state",
        "parameters": [
          {
            "name": "device_id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ElectrometerID"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ElectrometerStateSet"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ElectrometerState"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/orbitos-api/v1/{device_id}/data": {
      "get": {
        "tags": [
          "electrometer"
        ],
        "summary": "Get Current Data",
        "description": "Get the current data from the electrometer for a specified time frame.",
        "operationId": "electrometer-get_current_data",
        "parameters": [
          {
            "name": "device_id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ElectrometerID"
            }
          },
          {
            "name": "start",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Start"
            }
          },
          {
            "name": "end",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "title": "End"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/orbitos-api/v1/{device_id}/continuous-measurement/start": {
      "post": {
        "tags": [
          "electrometer"
        ],
        "summary": "Start Continuous Measurement",
        "description": "Start continuous measurement on the electrometer.",
        "operationId": "electrometer-start_continuous_measurement",
        "parameters": [
          {
            "name": "device_id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ElectrometerID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
